# Copy this file to .env (or .env.local) and fill in your own values.
# Never commit the real file: .env* is git-ignored except this example.

# PostgreSQL 15+ connection string. Required at build time and at runtime.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/shashtna_dev"

# Signs session cookies and mobile tokens. At least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-with-a-random-string-of-at-least-32-characters"

# Optional. Where support tickets and admin uploads are stored.
#   local   -> .data/ and public/uploads/ on disk (default outside Netlify)
#   netlify -> Netlify Blobs (default when running on Netlify)
# SHASHTNA_STORAGE=local

# Mobile push notifications (Expo Push Service → FCM / APNs).
# Optional: only needed when "Enhanced push security" is on for the Expo project.
# EXPO_ACCESS_TOKEN=""
# Set to 1 to stop sending pushes (in-app notifications are still created).
# PUSH_DISABLED=1

# Protects /api/cron/push, called every 5 minutes by
# netlify/functions/push-dispatch.mts (scheduled notifications, renewal
# reminders, push receipts). At least 24 characters; set it on Netlify too.
# CRON_SECRET="replace-with-a-random-string"

# Branch/test deploys only — NEVER set in production. Prefixes every Netlify
# Blobs store (payment proofs, support tickets, admin media, package images)
# so a test deploy with its own database can't read or overwrite production
# files, e.g. SHASHTNA_BLOB_NAMESPACE=mobile-test → "mobile-test--shashtna-support".
# SHASHTNA_BLOB_NAMESPACE=
