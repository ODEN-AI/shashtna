// use prisma-next

model User {
  id           Int      @id @default(autoincrement())
  name         String
  phone        String   @unique
  email        String?  @unique
  passwordHash String
  role         String   @default("CUSTOMER")
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
  preferredContact String?
  renewalReminders Boolean  @default(true)
  marketingOptIn   Boolean  @default(false)
  // Session revocation: tokens carry this version; bumping it (password
  // change/reset, "sign out everywhere") invalidates every existing session.
  tokenVersion     Int      @default(0)
  // Login throttling.
  failedLogins     Int      @default(0)
  lockedUntil      TimestamptzString?

  subscriptions        Subscription[]
  subscriptionRequests SubscriptionRequest[]
}

model Subscription {
  id              Int      @id @default(autoincrement())
  userId          Int
  user             User     @relation(fields: [userId], references: [id])
  serviceType     String   @default("IPTV")
  username        String?  @unique
  password        String?
  macAddress      String?
  deviceId        String?  @unique
  status          String   @default("ACTIVE")
  packageName     String
  startDate       TimestamptzString
  expiryDate      TimestamptzString
  connections     Int      @default(0)
  maxConnections  Int      @default(1)
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
  packageId       Int?
}

model Package {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  serviceType     String   @default("IPTV")
  price           Int
  durationMonths  Int
  durationLabel   String
  description     String
  specifications  String
  notes           String?
  imageUrl        String?
  isActive        Boolean  @default(true)
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
  devices         PackageDevice[]
}

model Device {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  serviceType     String   @default("IPTV")
  price           Int
  description     String
  specifications  String
  notes           String?
  imageUrl        String?
  isActive        Boolean  @default(true)
  updatedAt       temporal.updatedAtString()
  packages        PackageDevice[]
}

model PackageDevice {
  id              Int      @id @default(autoincrement())
  packageId       Int
  package         Package  @relation(fields: [packageId], references: [id])
  deviceId        Int
  device          Device   @relation(fields: [deviceId], references: [id])
  createdAt       TimestamptzString @default(now())

  @@unique([packageId, deviceId])
}

model App {
  id           Int      @id @default(autoincrement())
  name         String
  slug         String   @unique
  description  String
  platform     String
  version      String?
  downloadUrl  String
  imageUrl     String?
  instructions String?
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()
}

model SubscriptionRequest {
  id              Int      @id @default(autoincrement())
  userId          Int
  user            User     @relation(fields: [userId], references: [id])
  planSlug        String
  serviceType     String   @default("IPTV")
  serviceName     String
  requestType     String   @default("NEW")
  price           Int
  durationMonths  Int      @default(12)
  durationLabel   String   @default("1 Year")
  bonusYears      Int      @default(0)
  deviceId        String?
  deviceName      String?
  devicePrice     Int?
  contactMethod   String   @default("PENDING")
  status          String   @default("PENDING")
  createdAt       TimestamptzString @default(now())
  updatedAt       TimestamptzString @default(now())
  paymentMethod    String?
  paymentReference String?
  customerNote     String?
  adminNote        String?
  subscriptionId   Int?
}

model Receipt {
  id              Int      @id @default(autoincrement())
  receiptNumber   String   @unique
  userId          Int
  subscriptionId  Int
  serviceType     String   @default("IPTV")
  serviceName     String
  price           Int
  durationMonths  Int
  durationLabel   String
  bonusYears      Int      @default(0)
  status          String   @default("PAID")
  createdAt       TimestamptzString @default(now())
  orderId         Int?
}

// Unified activity log: admin audit trail, customer-visible history and
// order / subscription timelines.
model ActivityEvent {
  id              Int      @id @default(autoincrement())
  actorUserId     Int?
  actorRole       String?
  userId          Int?
  entityType      String
  entityId        String?
  action          String
  summary         String
  details         String?
  customerVisible Boolean  @default(false)
  createdAt       TimestamptzString @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// In-app notifications shown in My Shashtna.
model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String
  link      String?
  dedupeKey String?  @unique
  readAt    TimestamptzString?
  createdAt TimestamptzString @default(now())
  // Optional image (admin campaigns) and the campaign that produced it.
  imageUrl   String?
  campaignId Int?

  @@index([userId])
}

// Phones running the Shashtna mobile app. One row per push token; a customer
// can have several devices. Tokens are deactivated on logout or when the push
// provider reports them as no longer registered.
model PushDevice {
  id           Int      @id @default(autoincrement())
  userId       Int
  token        String   @unique
  provider     String   @default("EXPO")
  platform     String
  deviceName   String?
  appVersion   String?
  isActive     Boolean  @default(true)
  lastSeenAt   TimestamptzString @default(now())
  lastError    String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@index([userId])
}

// Admin-authored mobile notifications ("إشعارات الهواتف"). Sending a campaign
// writes one Notification per recipient (the same in-app records the website
// shows) and pushes it to the recipients' active devices.
model PushCampaign {
  id             Int      @id @default(autoincrement())
  title          String
  body           String
  type           String   @default("MESSAGE")
  imageUrl       String?
  link           String?
  audience       String   @default("ALL")
  targetUserId   Int?
  status         String   @default("DRAFT")
  scheduledAt    TimestamptzString?
  sentAt         TimestamptzString?
  recipientCount Int      @default(0)
  deviceCount    Int      @default(0)
  acceptedCount  Int      @default(0)
  failedCount    Int      @default(0)
  lastError      String?
  createdBy      Int
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()

  @@index([status])
}

// Push tickets returned by the push provider, kept until their delivery
// receipt has been checked (stale tokens are deactivated from receipts).
model PushTicket {
  id             Int      @id @default(autoincrement())
  ticketId       String   @unique
  deviceId       Int
  campaignId     Int?
  status         String   @default("PENDING")
  error          String?
  createdAt      TimestamptzString @default(now())
  checkedAt      TimestamptzString?

  @@index([status])
}

// Ads and announcements for the website and (later) Shashtna Player.
model Announcement {
  id          Int      @id @default(autoincrement())
  kind        String   @default("AD")
  title       String
  description String?
  imageUrl    String?
  ctaLabel    String?
  ctaUrl      String?
  target      String   @default("ALL")
  placement   String   @default("HOME_CAROUSEL")
  style       String   @default("STANDARD")
  priority    Int      @default(0)
  isActive    Boolean  @default(true)
  startsAt    TimestamptzString?
  endsAt      TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

// Admin-published service status incidents and maintenance windows.
model ServiceIncident {
  id          Int      @id @default(autoincrement())
  title       String
  message     String
  status      String
  component   String   @default("ALL")
  isPublished Boolean  @default(true)
  startsAt    TimestamptzString @default(now())
  resolvedAt  TimestamptzString?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

// Admin-editable site content and configuration (contact links, hours,
// payment instructions, policy text).
model SiteSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String
  updatedBy   Int?
  updatedAt   temporal.updatedAtString()
}

// Leads from the Shashtna Digital (agency) request form.
model ServiceLead {
  id          Int      @id @default(autoincrement())
  userId      Int?
  name        String
  phone       String
  projectType String
  budget      String?
  timeline    String?
  details     String
  status      String   @default("NEW")
  adminNote   String?
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

// Staff-assisted password reset: a customer requests a reset, staff verify
// the customer and issue a short-lived one-time code.
model PasswordReset {
  id        Int      @id @default(autoincrement())
  userId    Int
  status    String   @default("REQUESTED")
  codeHash  String?
  attempts  Int      @default(0)
  expiresAt TimestamptzString?
  issuedBy  Int?
  issuedAt  TimestamptzString?
  usedAt    TimestamptzString?
  createdAt TimestamptzString @default(now())

  @@index([userId])
}
